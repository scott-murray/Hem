; Hem — Bunny's Carrot Quest
; Godot 4.x project — dual-target: Linux ARM (RPi) + HTML5 (browser)
;
; Input Map:
;   Keyboard: Arrow keys / WASD for movement, Space/W/Up for jump, Down/S for dig
;   Gamepad: D-pad / left stick for movement, A (cross) for jump, B (circle) for dig
;   Touch:  left-half hold = walk left, right-half hold = walk right,
;           swipe up = jump, swipe down = dig

config_version=5

[application]
config/name="Hem"
config/description="Bunny's Carrot Quest — a pixel-art platformer"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.051, 0.051, 0.051, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true

[input]
jump={
    "deadzone": 0.2,
    "events": [
        Object(InputEventKey, "resource_local_to_scene": false, "resource_name": "", "device": -1, "window_id": 0, "alt_pressed": false, "shift_pressed": false, "ctrl_pressed": false, "meta_pressed": false, "pressed": false, "keycode": 0, "physical_keycode": 32, "key_label": 0, "unicode": 32, "location": 0, "echo": false, "script": null),
        Object(InputEventKey, "resource_local_to_scene": false, "resource_name": "", "device": -1, "window_id": 0, "alt_pressed": false, "shift_pressed": false, "ctrl_pressed": false, "meta_pressed": false, "pressed": false, "keycode": 0, "physical_keycode": 87, "key_label": 0, "unicode": 119, "location": 0, "echo": false, "script": null),
        Object(InputEventKey, "resource_local_to_scene": false, "resource_name": "", "device": -1, "window_id": 0, "alt_pressed": false, "shift_pressed": false, "ctrl_pressed": false, "meta_pressed": false, "pressed": false, "keycode": 0, "physical_keycode": 4194320, "key_label": 0, "unicode": 0, "location": 0, "echo": false, "script": null),
        Object(InputEventJoypadButton, "resource_local_to_scene": false, "resource_name": "", "device": -1, "button_index": 0, "pressure": 0.0, "pressed": false, "script": null)
    ]
}
move_left={
    "deadzone": 0.2,
    "events": [
        Object(InputEventKey, "resource_local_to_scene": false, "resource_name": "", "device": -1, "window_id": 0, "alt_pressed": false, "shift_pressed": false, "ctrl_pressed": false, "meta_pressed": false, "pressed": false, "keycode": 0, "physical_keycode": 4194319, "key_label": 0, "unicode": 0, "location": 0, "echo": false, "script": null),
